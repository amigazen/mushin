demos: muimaster.lib
  smake -f //demos/smakefile

include: buildincludes zunemaster_lib.sfd
#  -delete include all
#  -makedir include
#  -makedir include/libraries include/clib include/proto include/pragma
  buildincludes >include/libraries/mui.h
  -makedir t:zunemaster
  copy zunemaster_lib.sfd t:zunemaster
  execute <<
    cd t:zunemaster
    sfd zunemaster_lib.sfd
<
  fd2pragma t:zunemaster/fd/zunemaster_lib.fd to include/pragma
  copy t:zunemaster/protos/zunemaster_protos.h to include/clib
  fd2pragma t:zunemaster/fd/zunemaster_lib.fd special=35 to include/proto
  delete t:zunemaster all
# NOTE: do not overwrite include/proto/muimaster.h here.  An "echo" block used
# to replace the header generated on the line above with an empty three-line
# stub.  79 sources in this library include <proto/muimaster.h> purely to pick
# up <pragmas/muimaster_pragmas.h>, which supplies the register mapping for
# MUI_GetClass, MUI_NewObject, MUI_Redraw, MUI_Layout and the rest.  With the
# stub in place those calls compiled as prototype-less stack-argument calls
# into functions that read their arguments from A0/D0 - and IGNORE=63 below
# hid the missing-prototype warnings.  It also meant "smake all" and
# "smake zunemaster.library" produced different binaries.
# None of the files that *define* the MUI_* entry points include this header,
# so there is no pragma-versus-definition conflict to work around.

buildincludes: buildincludes.c
  sc link buildincludes.c

# Built without gst=all.gst on purpose.  all.gst carries the library's own
# "mui.h", and compiling opentest.c with it would defeat the point of the
# test: opentest exists to prove that the generated include/libraries/mui.h is
# self-sufficient for an outside caller and that MUIMASTER_NAME in it matches
# the library actually installed.  With the GST in play its <libraries/mui.h>
# would expand to nothing and MUIMASTER_NAME would come from the internal
# header instead.
#
# MUIMASTER_DROPIN is deliberately not defined here, so the compiled-in default
# is "zunemaster.library" - the name an application gets from the public header
# as shipped.  To test the drop-in build instead, name it on the command line
# rather than rebuilding:  opentest muimaster.library
objs/opentest.o: opentest.c
  sc $(CFLAGS_COMMON) incdir=include opentest.c objname=objs/opentest.o

clean:
  -delete objs all
  -delete test
  -delete opentest
  -delete zunemaster.library
  -delete muimaster.library
