# Drop-in replacement build: "smake muimaster.library".
#
# Identical to zunemaster.library in every object except this one, which is
# recompiled with MUIMASTER_DROPIN so that LIBNAME, the $VER string and
# MUIMASTER_NAME all say "muimaster.library".  Nothing else in the library
# refers to its own name - internally it uses
# MUIMasterBase->lib_Node.ln_Name at runtime - so one extra object is all the
# variant costs.
#
# The name has to match the installed filename because OpenLibrary() loads
# LIBS:<requested name> and then looks the RomTag name up in the library list;
# if the two disagree the open fails even though the file loaded.  Install this
# one as LIBS:muimaster.library and zunemaster.library as
# LIBS:zunemaster.library.
objs/muimaster_lib.o: zunemaster_lib.c
  sc $(CFLAGS) stringmerge DEFINE=MUIMASTER_DROPIN zunemaster_lib.c objname=$@

