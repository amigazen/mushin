# headers.c now includes the library's own "mui.h" as well as the system
# headers, so all.gst carries the internal MUI declarations and, crucially,
# the LIBRARIES_MUI_H guard.  That stops the PRIV-stripped
# <libraries/mui.h> - reached from every class source through
# <proto/muimaster.h> -> <clib/muimaster_protos.h> - from claiming the guard
# first and hiding every private field and identifier.  See headers.c.
#
# Because those declarations are now baked into the GST, the GST has to be
# rebuilt whenever any of them changes.  The list below is the full transitive
# closure of the quoted includes reachable from "mui.h"; without it, editing a
# class header or support_amigaos.h left a stale all.gst in place and the
# change simply did not reach the compiler - which is how a newly added
# ForeachNodeSafe() came out as an implicit function call.
#
# The GST is built with the same options as the sources that use it,
# $(CFLAGS_COMMON) in particular for idlen=40.  Without it the GST keeps only
# the first 32 characters of each name, while a source compiled with idlen=40
# looks the full name up, so every identifier of 33 characters or more that
# the GST holds becomes invisible: MUIM_Window_AddControlCharHandler and
# MUIA_Window_UseBottomBorderScroller among them.  This did not matter while
# all.gst carried only the system headers, whose names are short, but it does
# now that "mui.h" is in it.  The longest name in the library is 35
# characters, so 40 has room to spare.
#
# MUIMASTER_LIBRARY_BUILD is passed for the same reason it is in $(CFLAGS):
# so the GST is built from the same headers the sources see.
all.gst: headers.c \
  classes/aboutmui.h classes/application.h classes/area.h \
  classes/balance.h classes/bitmap.h classes/bodychunk.h \
  classes/boopsi.h classes/chunkyimage.h classes/coloradjust.h \
  classes/colorfield.h classes/configdata.h classes/crawling.h \
  classes/cycle.h classes/dataspace.h classes/dirlist.h \
  classes/dtpic.h classes/family.h classes/floattext.h \
  classes/frameadjust.h classes/framedisplay.h classes/gauge.h \
  classes/group.h classes/image.h classes/imageadjust.h \
  classes/imagedisplay.h classes/knob.h classes/levelmeter.h \
  classes/list.h classes/listview.h classes/mccprefs.h \
  classes/menuitem.h classes/notify.h classes/numeric.h \
  classes/numericbutton.h classes/palette.h classes/penadjust.h \
  classes/pendisplay.h \
  classes/pixmap.h classes/popasl.h classes/popframe.h \
  classes/popimage.h classes/poplist.h classes/popobject.h \
  classes/poppen.h classes/popscreen.h classes/popstring.h \
  classes/process.h classes/prop.h classes/radio.h \
  classes/rectangle.h classes/register.h classes/scale.h \
  classes/scrollbar.h classes/scrollbutton.h classes/scrollgroup.h \
  classes/semaphore.h classes/settings.h classes/settingsgroup.h \
