; $VER: Install-Mushin 1.0 (03.10.2026)
; Run with Amiga Installer 43 or newer.

(set @app-name "Mushin")
(set @default-dest "")
(if (< @installer-version (* 43 65536))
    (abort "Mushin installation requires Amiga Installer 43 or newer.")
)
(welcome "Install Mushin's native AmigaOS libraries.")
; Novice mode normally skips questions. Replacements must be explicit.
(if (< @user-level 1) (set @user-level 1))
(set #package (pathonly @icon))
(set #selected 0)

(procedure P_Version #number
    ("%ld.%ld" (/ #number 65536) (bitand #number 65535))
)

(procedure P_InstallLibrary #name #purpose
    (set #source (tackon (tackon #package "Libs") #name))
    (set #destination (tackon "LIBS:" #name))
    (set #backup (cat #destination ".mushin-old"))
    (set #bundled (getversion #source))
    (set #existing (exists #destination))
    (set #resident (getversion #name (resident)))
    (set #prompt (cat #name " is not installed in LIBS:.\n"))
    (if (= #existing 2)
        (abort (cat #destination " is a directory, not a library file."))
    )
    (if #existing
        (
            (set #installed (getversion #destination))
            (if #installed
                (set #prompt (cat #name " v" (P_Version #installed)
                    " already installed.\n"))
                (set #prompt (cat #name
                    " already installed (version unknown).\n"))
            )
        )
    )
    (set #prompt (cat #prompt "Bundled is v" (P_Version #bundled) ".\n"))
    (if #existing
        (
            (if (= #installed #bundled)
                (set #prompt (cat #prompt "This replaces the same version.\n"))
            )
            (if (> #installed #bundled)
                (set #prompt (cat #prompt "This is a downgrade.\n"))
            )
            (set #prompt (cat #prompt "Original backup: " #backup "\n"))
            (if (exists #backup)
                (set #prompt (cat #prompt "The existing backup will be kept.\n"))
            )
        )
    )
    (if #resident
        (set #prompt (cat #prompt "Currently in memory: v"
            (P_Version #resident) ". Reboot to use the installed file.\n"))
    )
    (set #prompt (cat #prompt "\n" #purpose "\n\nInstall to "
        #destination "?"))
    (if (askbool
            (prompt #prompt)
            (help "Install copies the bundled library to LIBS:. Skip keeps"
                  "the current system unchanged. Existing files are backed"
                  "up once; a previous Mushin backup is never overwritten.")
            (choices "Install" "Skip")
            (default 0)
        )
        (
            (if (= (exists #backup) 2)
                (abort (cat #backup " is a directory. No file was replaced."))
            )
            (if (and #existing (= (exists #backup) 0))
                (copyfiles
                    (source #destination)
                    (dest "LIBS:")
                    (newname (cat #name ".mushin-old"))
                    (optional "fail")
                )
            )
            (copyfiles
                (source #source)
                (dest "LIBS:")
                (optional "fail")
            )
            (set #selected (+ #selected 1))
        )
    )
)

; Check the entire payload before offering any system changes.
(if (or
        (<> (exists (tackon #package "Libs/zunemaster.library")) 1)
        (<> (exists (tackon #package "Libs/muimaster.library")) 1)
    )
    (abort "The package is incomplete. Extract the complete Mushin archive.")
)
(foreach (tackon #package "Libs") "#?.library"
    (if (= (getversion (tackon (tackon #package "Libs") @each-name)) 0)
        (abort (cat "Cannot read the bundled version of " @each-name "."))
    )
)

(P_InstallLibrary "zunemaster.library"
    "This library installs alongside MUI. opentest uses it by default.")
(complete 50)
(P_InstallLibrary "muimaster.library"
    "This replaces MUI for applications using the standard library name.")
(complete 100)

(if @pretend
    (message "Pretend mode finished. No libraries were copied.")
    (if #selected
        (message ("Installed %ld library file(s).\n" #selected)
            "Close applications and reboot before using the new libraries.")
        (message "No libraries were selected. The system was not changed.")
    )
)
